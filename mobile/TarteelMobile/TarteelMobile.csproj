<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-windows10.0.19041.0</TargetFrameworks>
    <RuntimeIdentifier Condition="$(TargetFramework.Contains('-windows'))">win-x64</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <RootNamespace>TarteelMobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">31.0</SupportedOSPlatformVersion>
    <!-- Use Mono runtime on Android to avoid CoreCLR MSI install issues -->
    <UseNativeAot Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</UseNativeAot>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

    <!-- App Identity -->
    <ApplicationTitle>Tarteel</ApplicationTitle>
    <ApplicationId>com.tarteel.mobile</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <!-- Packaging script can override these at publish time -->
    <OfflineModelDir Condition="'$(OfflineModelDir)' == ''">$(MSBuildProjectDirectory)\..\..\offline-assets\models</OfflineModelDir>
    <OfflineDataDir Condition="'$(OfflineDataDir)' == ''">$(MSBuildProjectDirectory)\..\..\offline-assets\data</OfflineDataDir>
    <OfflineExtrasDir Condition="'$(OfflineExtrasDir)' == ''">$(MSBuildProjectDirectory)\..\..\offline-assets\extras</OfflineExtrasDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/appiconfg.svg" Color="#512BD4" />
    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources/AppIcon/appicon.svg" Color="#512BD4" BaseSize="128,128" />
    <!-- Fonts -->
    <MauiFont Include="Resources/Fonts/*.ttf" />
    <MauiImage Include="Resources/Images/*.svg" />
    <!-- Raw Assets (audio prompts, etc.) -->
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-windows10.0.19041.0' and Exists('$(OfflineModelDir)')">
    <MauiAsset Include="$(OfflineModelDir)\**\*" LogicalName="offline/models/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-windows10.0.19041.0' and Exists('$(OfflineDataDir)')">
    <MauiAsset Include="$(OfflineDataDir)\**\*" LogicalName="offline/data/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('android')) and Exists('$(OfflineDataDir)')">
    <MauiAsset Include="$(OfflineDataDir)\**\*" LogicalName="offline/data/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-windows10.0.19041.0' and Exists('$(OfflineExtrasDir)')">
    <MauiAsset Include="$(OfflineExtrasDir)\**\*" LogicalName="offline/extras/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.*" />
    <PackageReference Include="NAudio" Version="2.2.1" Condition="$(TargetFramework.Contains('-windows'))" />
    <PackageReference Include="Whisper.net" Version="1.7.3" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.7.3" />
  </ItemGroup>

  <!-- WinAppSDK 1.7 MSBuild task (Microsoft.Build.Msix.dll) was compiled against .NET 8 and
       requires System.Security.Permissions v8.0.0.0 to be resolvable by the MSBuild host.
       This reference makes the assembly available so the WinAppSdkGenerateAppxManifest task
       does not throw a FileNotFoundException during the Windows build. -->
  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <PackageReference Include="System.Security.Permissions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LocalRecitationCore\TarteelClone.LocalRecitationCore.csproj" />
    <ProjectReference Include="..\..\src\QuranEngine\TarteelClone.QuranEngine.csproj" />
    <ProjectReference Include="..\..\src\SearchService\TarteelClone.SearchService.csproj" />
    <ProjectReference Include="..\..\src\UserService\TarteelClone.UserService.csproj" />
    <ProjectReference Include="..\..\src\Api\TarteelClone.Api.csproj" />
  </ItemGroup>

</Project>
