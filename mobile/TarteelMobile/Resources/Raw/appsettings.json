{
  "Offline": {
    "Mode": "LocalOnly",
    "EnableDiagnostics": true
  },
  "LocalWhisper": {
    "Enabled": true,
    "PreferLocalEngine": true,
    "PrimaryTier": "base",
    "FallbackTier": "small",
    "WarmupOnStartup": true,
    "AllowMockWhenUnavailable": true,
    "Language": "ar",
    "InferenceTimeoutSeconds": 30,
    "BeamSearchWidth": 12,
    "Temperature": 0.0,
    "ThreadsOverride": 0,
    "NoSpeechThreshold": 0.6,
    "EntropyThreshold": 2.4,
    "NoTimestamps": true,
    "Base": {
      "ModelPath": "offline/models/ggml-base.bin",
      "DownloadUrl": "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.bin?download=true"
    },
    "Small": {
      "ModelPath": "offline/models/ggml-small.bin",
      "DownloadUrl": "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-small.bin?download=true"
    },
    "Medium": {
      "ModelPath": "offline/models/ggml-medium.bin",
      "DownloadUrl": "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-medium.bin?download=true"
    }
  },
  "LocalQuranData": {
    "DatabaseFileName": "quran-local.db",
    "DefaultTranslationLanguage": "en",
    "DefaultTranslator": "Saheeh International",
    "DefaultUserKey": "offline-default",
    "PreferredAssetImportFile": "quran/import/full_quran.json",
    "FallbackSeedAssetImportFile": "quran/import/seed_verses.json",
    "ExternalImportFile": ""
  }
}
