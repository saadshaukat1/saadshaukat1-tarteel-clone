<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TarteelMobile.ViewModels"
             x:Class="TarteelMobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Tarteel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">
    <ScrollView Orientation="Vertical">
        <VerticalStackLayout Spacing="0">
            <!-- Header Banner -->
            <Grid BackgroundColor="{StaticResource PrimaryDark}" Padding="24,36,24,24">
                <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <BoxView WidthRequest="4" BackgroundColor="{StaticResource Accent}" CornerRadius="2" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Tarteel" FontSize="{StaticResource FontSizeHeroVerse}" FontAttributes="Bold" TextColor="{StaticResource TextOnPrimary}" />
                            <Label Text="Offline recitation console" FontSize="{StaticResource FontSizeSubtitle}" TextColor="{StaticResource AccentMuted}" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" WidthRequest="180" HorizontalOptions="Start" BackgroundColor="{StaticResource BorderSubtle}" Margin="16,6,0,0" />
                    <Label Text="A quiet workspace for hifz practice, verse matching, and tajweed coaching." FontSize="{StaticResource FontSizeBody}" TextColor="{StaticResource TextSecondary}" MaximumWidthRequest="480" Margin="16,0,0,0" />
                </VerticalStackLayout>
            </Grid>

            <!-- Login Form Area -->
            <Grid x:Name="LoginGrid" Padding="20,24,20,32" BackgroundColor="{StaticResource Surface}" ColumnDefinitions="*" RowDefinitions="Auto,Auto" RowSpacing="20">
                <VerticalStackLayout x:Name="LoginFormLayout" Spacing="16" MaximumWidthRequest="520" HorizontalOptions="Fill">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Local session" FontSize="{StaticResource FontSizeSubtitle}" FontAttributes="Bold" />
                        <Label Text="Sign in to keep your practice record connected across sessions." FontSize="{StaticResource FontSizeBody}" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>

                    <!-- Input Fields: Stacked for mobile -->
                    <VerticalStackLayout x:Name="LoginFieldsLayout" Spacing="12">
                        <VerticalStackLayout x:Name="EmailFieldLayout" Spacing="4">
                            <Label Text="Email" FontSize="{StaticResource FontSizeCaption}" TextColor="{StaticResource TextSecondary}" />
                            <Entry Text="{Binding Email}" Keyboard="Email" ReturnType="Next" Placeholder="name@example.com" FontSize="{StaticResource FontSizeBodyLarge}" HeightRequest="48" />
                        </VerticalStackLayout>
                        <VerticalStackLayout x:Name="PasswordFieldLayout" Spacing="4">
                            <Label Text="Password" FontSize="{StaticResource FontSizeCaption}" TextColor="{StaticResource TextSecondary}" />
                            <Entry x:Name="PasswordEntry" Text="{Binding Password}" IsPassword="True" ReturnType="Done" Placeholder="Your password" FontSize="{StaticResource FontSizeBodyLarge}" HeightRequest="48" ReturnCommand="{Binding LoginCommand}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Error Alert -->
                    <Label Text="{Binding Error}" TextColor="{StaticResource Error}" FontSize="{StaticResource FontSizeBody}" IsVisible="{Binding Error, Converter={StaticResource StringToBoolConverter}}" />

                    <!-- Action Buttons -->
                    <VerticalStackLayout x:Name="LoginActionsLayout" Spacing="10">
                        <Button Text="Log in" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="50" HorizontalOptions="Fill" Command="{Binding LoginCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                        <Button Text="Create account" Style="{StaticResource OutlineButtonStyle}" HeightRequest="50" HorizontalOptions="Fill" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Offline Readiness Footer Badge -->
                <VerticalStackLayout x:Name="OfflineStatusLayout" Grid.Row="1" Spacing="4" HorizontalOptions="Center" Margin="0,12,0,0">
                    <Label Text="OFFLINE READY" FontSize="{StaticResource FontSizeNano}" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
                    <Label Text="Local SQLite · Whisper.net" FontSize="{StaticResource FontSizeCaption}" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Accent}" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
