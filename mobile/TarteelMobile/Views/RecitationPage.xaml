<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TarteelMobile.ViewModels"
             x:Class="TarteelMobile.Views.RecitationPage"
             Title="Recite">

    <Grid RowDefinitions="*,Auto,Auto,Auto" Padding="24" BackgroundColor="{StaticResource Surface}">

        <!-- Arabic verse display -->
        <ScrollView Grid.Row="0">
            <Label x:Name="ArabicLabel"
                   FormattedText="{Binding HighlightedArabicText}"
                   FontFamily="ArabicRegular"
                   FontSize="28"
                   HorizontalTextAlignment="End"
                   LineBreakMode="WordWrap"
                   TextColor="{StaticResource OnSurface}" />
        </ScrollView>

        <!-- Confidence bar -->
        <ProgressBar Grid.Row="1"
                     Progress="{Binding Confidence}"
                     ProgressColor="{StaticResource Primary}"
                     Margin="0,8" />

        <!-- Status message -->
        <VerticalStackLayout Grid.Row="2" Spacing="2" Margin="0,4">
            <Label Text="{Binding StatusMessage}"
                   HorizontalTextAlignment="Center"
                   FontSize="14"
                   TextColor="{StaticResource Primary}" />
            <Label Text="{Binding ProcessingSummary}"
                   HorizontalTextAlignment="Center"
                   FontSize="12"
                   TextColor="#6B7280" />
            <Label Text="Legend: Green = matched • Red = needs correction • Gray = not processed yet"
                   HorizontalTextAlignment="Center"
                   FontSize="11"
                   TextColor="#6B7280" />
        </VerticalStackLayout>

        <HorizontalStackLayout Grid.Row="3" HorizontalOptions="Center" Spacing="12" Margin="0,16,0,0">
            <!-- Mic button -->
            <Button Text="{Binding IsRecording, Converter={StaticResource BoolToMicTextConverter}}"
                    BackgroundColor="{Binding IsRecording,
                        Converter={StaticResource BoolToColorConverter},
                        ConverterParameter='#E53935|#1A6B3C'}"
                    TextColor="White"
                    CornerRadius="40"
                    HeightRequest="80"
                    WidthRequest="80"
                    Command="{Binding ToggleRecordingCommand}" />
            <Button Text="Reset Session"
                    BackgroundColor="{StaticResource PrimaryDark}"
                    TextColor="White"
                    HeightRequest="44"
                    VerticalOptions="Center"
                    Command="{Binding StopSessionCommand}" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
