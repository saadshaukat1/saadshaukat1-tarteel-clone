<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TarteelMobile.ViewModels"
             xmlns:models="clr-namespace:TarteelMobile.Models"
             x:Class="TarteelMobile.Views.MushafPageView"
             x:DataType="vm:MushafPageViewModel"
             Title="Mushaf"
             BackgroundColor="{StaticResource Surface}">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="6">
        <!-- Page Navigation Header -->
        <Grid Grid.Row="0" Padding="14,8,14,4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Button Grid.Column="0" Text="◀ Prev" Command="{Binding GoToPreviousPageCommand}" Style="{StaticResource CompactActionButtonStyle}" HeightRequest="48" MinimumHeightRequest="48" Padding="14,0" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                <Label Text="{Binding PageLabel}" FontAttributes="Bold" FontSize="{StaticResource FontSizeBodyLarge}" TextColor="{StaticResource Accent}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding VerseRangeLabel}" FontSize="{StaticResource FontSizeMicro}" TextColor="{StaticResource TextTertiary}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="Next ▶" Command="{Binding GoToNextPageCommand}" Style="{StaticResource CompactActionButtonStyle}" HeightRequest="48" MinimumHeightRequest="48" Padding="14,0" />
        </Grid>

        <!-- Quick Jump Toolbar (Juz & Surah Selectors) -->
        <Grid Grid.Row="1" Padding="14,0,14,4" ColumnDefinitions="1.2*,1.5*,1*" ColumnSpacing="6" IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Spacing="1">
                <Label Text="Juz" FontSize="{StaticResource FontSizeMicro}" TextColor="{StaticResource TextSecondary}" />
                <Picker ItemsSource="{Binding JuzList}" ItemDisplayBinding="{Binding JuzNum, StringFormat='Juz {0}', x:DataType=models:JuzInfo}" SelectedItem="{Binding SelectedJuz}" HeightRequest="48" MinimumHeightRequest="48" SelectedIndexChanged="OnJuzPickerChanged" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="1">
                <Label Text="Surah" FontSize="{StaticResource FontSizeMicro}" TextColor="{StaticResource TextSecondary}" />
                <Picker ItemsSource="{Binding SurahList}" ItemDisplayBinding="{Binding NameArabic, x:DataType=models:SurahInfo}" SelectedItem="{Binding SelectedSurah}" HeightRequest="48" MinimumHeightRequest="48" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" Spacing="1">
                <Label Text="Ayah" FontSize="{StaticResource FontSizeMicro}" TextColor="{StaticResource TextSecondary}" />
                <Picker ItemsSource="{Binding AyahNumbers}" SelectedItem="{Binding SelectedAyah}" HeightRequest="48" MinimumHeightRequest="48" />
            </VerticalStackLayout>
        </Grid>

        <!-- Arabic Search Bar -->
        <Grid Grid.Row="2" Padding="14,0,14,4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Placeholder="Search verses (Arabic)" Text="{Binding SearchQuery}" ReturnCommand="{Binding SearchCommand}" FontSize="{StaticResource FontSizeBody}" HeightRequest="48" MinimumHeightRequest="48" />
            <Button Grid.Column="1" Text="Search" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="48" MinimumHeightRequest="48" Padding="16,0" Command="{Binding SearchCommand}" />
        </Grid>

        <!-- 16-Line Mushaf Page Container -->
        <ScrollView Grid.Row="3" x:Name="PageScroll" Padding="10,0" Scrolled="OnPageScrolled">
            <Border StrokeThickness="1" Stroke="{StaticResource BorderSubtle}" BackgroundColor="{StaticResource SurfaceElevated}" HorizontalOptions="Center" MaximumWidthRequest="760" Padding="10,12" StrokeShape="RoundRectangle 8">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.28" />
                </Border.Shadow>
                <Grid x:Name="LinesGrid" BackgroundColor="{StaticResource SurfaceElevated}" RowSpacing="0" ColumnSpacing="0" HorizontalOptions="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" />
                        <RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" />
                        <RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" />
                        <RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                </Grid>
            </Border>
        </ScrollView>

        <!-- Footer Instructions -->
        <Label Grid.Row="4" Text="Scroll down to advance · 16-line standard layout" FontSize="{StaticResource FontSizeNano}" TextColor="{StaticResource TextTertiary}" HorizontalTextAlignment="Center" Padding="0,2,0,8" />
    </Grid>
</ContentPage>
