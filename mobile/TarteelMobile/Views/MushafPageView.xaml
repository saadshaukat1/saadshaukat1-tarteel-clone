<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TarteelMobile.ViewModels"
             xmlns:models="clr-namespace:TarteelMobile.Models"
             x:Class="TarteelMobile.Views.MushafPageView"
             x:DataType="vm:MushafPageViewModel"
             Title="Mushaf"
             BackgroundColor="{StaticResource Surface}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="0">
        <Grid Grid.Row="0" Padding="16,10,16,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Button Grid.Column="0" Text="‹" SemanticProperties.Description="Previous page" Command="{Binding GoToPreviousPageCommand}" Style="{StaticResource CompactActionButtonStyle}" WidthRequest="48" HeightRequest="48" Padding="0" FontSize="28" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <Label Text="القرآن الكريم" FontFamily="{StaticResource ArabicFontFamily}" FontSize="22" TextColor="{StaticResource Accent}" HorizontalTextAlignment="Center" FlowDirection="RightToLeft" />
                <Label Text="{Binding PageLabel}" FontSize="{StaticResource FontSizeCaption}" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="›" SemanticProperties.Description="Next page" Command="{Binding GoToNextPageCommand}" Style="{StaticResource CompactActionButtonStyle}" WidthRequest="48" HeightRequest="48" Padding="0" FontSize="28" />
        </Grid>

        <Grid Grid.Row="1" Padding="16,4,16,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Label Text="{Binding VerseRangeLabel}" FontSize="{StaticResource FontSizeCaption}" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
            <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                <Label Text="Aa" FontSize="{StaticResource FontSizeBodyLarge}" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                <Button Text="−" SemanticProperties.Description="Decrease Quran font size" Command="{Binding DecreaseFontSizeCommand}" Style="{StaticResource CompactActionButtonStyle}" WidthRequest="48" HeightRequest="48" Padding="0" />
                <Label Text="{Binding FontSizeLabel}" FontSize="{StaticResource FontSizeCaption}" TextColor="{StaticResource TextSecondary}" MinimumWidthRequest="44" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                <Button Text="+" SemanticProperties.Description="Increase Quran font size" Command="{Binding IncreaseFontSizeCommand}" Style="{StaticResource CompactActionButtonStyle}" WidthRequest="48" HeightRequest="48" Padding="0" />
            </HorizontalStackLayout>
        </Grid>

        <Grid Grid.Row="2" Padding="16,0,16,10" ColumnDefinitions="1*,1.2*,1*" ColumnSpacing="8" IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Spacing="0">
                <Label Text="Juz" FontSize="{StaticResource FontSizeNano}" TextColor="{StaticResource TextTertiary}" />
                <Picker ItemsSource="{Binding JuzList}" ItemDisplayBinding="{Binding JuzNum, StringFormat='Juz {0}', x:DataType=models:JuzInfo}" SelectedItem="{Binding SelectedJuz}" HeightRequest="48" MinimumHeightRequest="48" SelectedIndexChanged="OnJuzPickerChanged" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="0">
                <Label Text="Surah" FontSize="{StaticResource FontSizeNano}" TextColor="{StaticResource TextTertiary}" />
                <Picker ItemsSource="{Binding SurahList}" ItemDisplayBinding="{Binding NameArabic, x:DataType=models:SurahInfo}" SelectedItem="{Binding SelectedSurah}" HeightRequest="48" MinimumHeightRequest="48" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" Spacing="0">
                <Label Text="Ayah" FontSize="{StaticResource FontSizeNano}" TextColor="{StaticResource TextTertiary}" />
                <Picker ItemsSource="{Binding AyahNumbers}" SelectedItem="{Binding SelectedAyah}" HeightRequest="48" MinimumHeightRequest="48" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="3" Padding="16,0,16,8" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Placeholder="Search verses in Arabic" Text="{Binding SearchQuery}" ReturnCommand="{Binding SearchCommand}" FontSize="16" HeightRequest="48" MinimumHeightRequest="48" />
            <Button Grid.Column="1" Text="Search" Style="{StaticResource CompactActionButtonStyle}" HeightRequest="48" MinimumHeightRequest="48" Padding="14,0" Command="{Binding SearchCommand}" />
        </Grid>

        <ScrollView Grid.Row="4" x:Name="PageScroll" Padding="14,0,14,8">
            <Border Stroke="{StaticResource MushafRule}" StrokeThickness="1" BackgroundColor="{StaticResource MushafPaper}" HorizontalOptions="Center" MaximumWidthRequest="760" Padding="14,12" StrokeShape="RoundRectangle 6">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.22" />
                </Border.Shadow>
                <Grid x:Name="LinesGrid" BackgroundColor="{StaticResource MushafPaper}" RowSpacing="0" ColumnSpacing="0" HorizontalOptions="Fill">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                </Grid>
            </Border>
        </ScrollView>

        <HorizontalStackLayout Grid.Row="5" Padding="16,4,16,10" HorizontalOptions="Center" Spacing="8">
            <Label Text="16-row view · approximate line breaks" FontSize="{StaticResource FontSizeCaption}" TextColor="{StaticResource TextTertiary}" VerticalTextAlignment="Center" />
            <Label Text="{Binding PageLabel}" FontSize="{StaticResource FontSizeCaption}" TextColor="{StaticResource TextSecondary}" VerticalTextAlignment="Center" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
