<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TarteelMobile.ViewModels"
             xmlns:models="clr-namespace:TarteelMobile.Models"
             xmlns:services="clr-namespace:TarteelMobile.Services"
             x:Class="TarteelMobile.Views.ProgressPage"
             x:Name="ProgressRoot"
             x:DataType="vm:ProgressViewModel"
             Title="Progress"
             BackgroundColor="{StaticResource Surface}">
    <Grid RowDefinitions="Auto,*,Auto" Padding="28,20,28,20">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
            <VerticalStackLayout Spacing="3">
                <Label Text="Practice record" FontSize="{StaticResource FontSizeTitle}" FontAttributes="Bold" />
                <Label Text="Your hifz dashboard: today, curriculum, and weak spots" FontSize="{StaticResource FontSizeCaption}" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Refresh" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="40" Command="{Binding RefreshCommand}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18">
                <Grid x:Name="SummaryGrid" ColumnDefinitions="*,240" ColumnSpacing="16">
                    <Border x:Name="TodaySummaryBorder" Padding="20" BackgroundColor="{StaticResource PrimaryDark}" Stroke="{StaticResource Primary}" StrokeThickness="1" StrokeShape="RoundRectangle 6">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="TODAY" FontSize="{StaticResource FontSizeNano}" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
                            <Label Text="{Binding DueSummary}" FontSize="{StaticResource FontSizeDisplay}" FontAttributes="Bold" TextColor="{StaticResource TextOnPrimary}" />
                            <Label Text="{Binding TodayMessage}" FontSize="{StaticResource FontSizeBody}" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding StreakDisplay}" FontSize="{StaticResource FontSizeCaption}" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
                            <Label Text="{Binding TodayNewCount, StringFormat='New: {0} · Review: {1}'}" FontSize="{StaticResource FontSizeMicro}" TextColor="{StaticResource TextSecondary}" />
                            <Button Text="Start today" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="48" IsEnabled="{Binding HasTodayAssignments}" Command="{Binding StartTodayCommand}" />
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout x:Name="CurriculumStack" Grid.Column="1" Spacing="10">
                        <Border x:Name="CurriculumBorder" Padding="20" BackgroundColor="{StaticResource SurfaceElevated}" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1" StrokeShape="RoundRectangle 6">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="CURRICULUM" FontSize="{StaticResource FontSizeNano}" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
                                <Label Text="{Binding PathName}" FontSize="{StaticResource FontSizeBodyLarge}" FontAttributes="Bold" />
                                <Label Text="{Binding PathProgress}" FontSize="{StaticResource FontSizeBody}" />
                                <Label Text="{Binding GoalLabel}" FontSize="{StaticResource FontSizeMicro}" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border x:Name="ApiStatusBorder" Padding="16,10" BackgroundColor="{StaticResource SurfacePanel}" StrokeThickness="0" StrokeShape="RoundRectangle 6">
                            <Label Text="{Binding ApiStatus}" FontSize="{StaticResource FontSizeMicro}" TextColor="{StaticResource TextSecondary}" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <Grid x:Name="ProgressColumnsGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                    <VerticalStackLayout x:Name="DueAssignmentsLayout" Spacing="8">
                        <Label Text="Today’s assignments" FontSize="{StaticResource FontSizeSubtitle}" FontAttributes="Bold" />
                        <CollectionView ItemsSource="{Binding TodayAssignments}" HeightRequest="260" EmptyView="Today is complete. Keep your current pace.">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="services:TodayAssignment">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="10,8" ColumnSpacing="12" BackgroundColor="{StaticResource SurfacePanel}">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Assignment.SurahNum, StringFormat='{0}'}" FontSize="{StaticResource FontSizeCaption}" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
                                            <Label Text="{Binding ReasonDisplay}" FontSize="{StaticResource FontSizeMicro}" TextColor="{StaticResource TextSecondary}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding Verse.ArabicText}" FontFamily="{StaticResource ArabicFontFamily}" FontSize="16" HorizontalTextAlignment="End" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                        <Button Grid.Column="2" Text="Start" BackgroundColor="Transparent" TextColor="{StaticResource Accent}" HeightRequest="44" MinimumWidthRequest="72" Clicked="OnAssignmentStartClicked" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                    <VerticalStackLayout x:Name="WeakVersesLayout" Grid.Column="1" Spacing="8">
                        <Label Text="Weak spots" FontSize="{StaticResource FontSizeSubtitle}" FontAttributes="Bold" />
                        <CollectionView ItemsSource="{Binding WeakVerses}" HeightRequest="260" EmptyView="No weak verses yet — keep it up!">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="services:WeakVerseRecommendation">
                                    <Grid ColumnDefinitions="Auto,*" Padding="10,8" ColumnSpacing="12" BackgroundColor="{StaticResource SurfacePanel}">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding SurahNum, StringFormat='{0}:{1}'}" FontSize="{StaticResource FontSizeCaption}" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
                                            <Label Text="{Binding ErrorCount, StringFormat='{0} error(s)'}" FontSize="{StaticResource FontSizeMicro}" TextColor="{StaticResource TextSecondary}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="Repeat this verse" FontSize="{StaticResource FontSizeMicro}" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" HorizontalTextAlignment="End" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label Text="{Binding RecommendationText}" FontSize="{StaticResource FontSizeBody}" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Grid>

                <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" />
                <Label Text="Practice history" FontSize="{StaticResource FontSizeSubtitle}" FontAttributes="Bold" />
                <CollectionView ItemsSource="{Binding VerseProgress}" EmptyView="No verses practiced yet. Start reciting.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:VerseProgress">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="10,8" ColumnSpacing="14">
                                <Label Text="{Binding Label}" FontSize="{StaticResource FontSizeCaption}" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
                                <Label Grid.Column="1" Text="{Binding ArabicText}" FontFamily="{StaticResource ArabicFontFamily}" FontSize="16" HorizontalTextAlignment="End" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="2" Text="{Binding MasteryDisplay}" FontAttributes="Bold" TextColor="{Binding MasteryColor}" />
                                <Label Grid.Column="3" Text="{Binding UpdatedDisplay}" FontSize="{StaticResource FontSizeMicro}" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
