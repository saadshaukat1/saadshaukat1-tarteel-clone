<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TarteelMobile.Views.ProgressPage"
             Title="My Progress">

    <Grid RowDefinitions="Auto,*" Padding="16" BackgroundColor="{StaticResource Surface}">

        <Label Grid.Row="0"
               Text="Hifz Progress"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="{StaticResource Primary}"
               Margin="0,0,0,12" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding MemorizedVerses}"
                        EmptyView="No verses recorded yet.">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Padding="8">
                        <Label Grid.Column="0"
                               Text="{Binding ArabicText}"
                               FontFamily="ArabicRegular"
                               FontSize="18"
                               HorizontalTextAlignment="End" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
