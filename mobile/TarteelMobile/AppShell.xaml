<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:TarteelMobile.Views"
       x:Class="TarteelMobile.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Recite"
                      ContentTemplate="{DataTemplate views:RecitationPage}"
                      Route="RecitationPage" />
        <ShellContent Title="Progress"
                      ContentTemplate="{DataTemplate views:ProgressPage}"
                      Route="ProgressPage" />
    </TabBar>
</Shell>
