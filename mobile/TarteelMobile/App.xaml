<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:TarteelMobile.Converters"
             x:Class="TarteelMobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <converters:BoolToMicTextConverter x:Key="BoolToMicTextConverter" />
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />

            <!-- Font families -->
            <x:String x:Key="UiFontFamily">Segoe UI</x:String>
            <x:String x:Key="ArabicFontFamily">Nastaleeq</x:String>
            <x:Int32 x:Key="FontWeightRegular">400</x:Int32>
            <x:Int32 x:Key="FontWeightMedium">500</x:Int32>
            <x:Int32 x:Key="FontWeightStrong">700</x:Int32>

            <!-- Type scale (px) with OnPlatform/OnIdiom responsive sizing -->
            <x:Double x:Key="FontSizeNano">10</x:Double>
            <x:Double x:Key="FontSizeMicro">11</x:Double>
            <x:Double x:Key="FontSizeCaption">12</x:Double>
            <x:Double x:Key="FontSizeBody">13</x:Double>
            <x:Double x:Key="FontSizeBodyLarge">14</x:Double>
            <x:Double x:Key="FontSizeSubtitle">16</x:Double>
            <x:Double x:Key="FontSizeTitle">20</x:Double>
            <x:Double x:Key="FontSizeDisplay">24</x:Double>
            
            <OnPlatform x:Key="FontSizeVerse" x:TypeArguments="x:Double">
                <On Platform="Android" Value="24" />
                <On Platform="WinUI,Windows,Default" Value="28" />
            </OnPlatform>
            
            <x:Double x:Key="FontSizeVerseTranscription">18</x:Double>
            
            <OnPlatform x:Key="FontSizeHeroVerse" x:TypeArguments="x:Double">
                <On Platform="Android" Value="28" />
                <On Platform="WinUI,Windows,Default" Value="36" />
            </OnPlatform>

            <!-- Arabic verse measure control (~48ch at FontSizeVerse 28px × Noto Naskh Arabic) -->
            <x:Double x:Key="ArabicVerseMaxWidth">700</x:Double>

            <!-- Line heights (multipliers) -->
            <x:Double x:Key="LineHeightTight">1.1</x:Double>
            <x:Double x:Key="LineHeightNormal">1.4</x:Double>
            <x:Double x:Key="LineHeightRelaxed">1.6</x:Double>
            <x:Double x:Key="LineHeightArabic">1.8</x:Double>

            <!-- Minimum touch target standard (Material 48dp) -->
            <x:Double x:Key="MinTouchTargetSize">48</x:Double>

            <!-- ── Corner-radius scale ── -->
            <x:Int32 x:Key="CornerRadiusSmall">4</x:Int32>
            <x:Int32 x:Key="CornerRadiusMedium">8</x:Int32>
            <x:Int32 x:Key="CornerRadiusLarge">12</x:Int32>
            <x:Int32 x:Key="CornerRadiusPill">24</x:Int32>

            <!-- ── Shadow elevations: restrained console depth ── -->
            <Shadow x:Key="ShadowCard" Brush="Black" Offset="0,1" Radius="4" Opacity="0.24" />
            <Shadow x:Key="ShadowElevated" Brush="Black" Offset="0,3" Radius="10" Opacity="0.34" />

            <!-- ── Primary palette ── -->
            <Color x:Key="Primary">#58C99F</Color>
            <Color x:Key="PrimaryHover">#78DDB8</Color>
            <Color x:Key="PrimaryPressed">#3BAE86</Color>
            <Color x:Key="PrimaryDark">#071412</Color>
            <Color x:Key="Accent">#D5A06F</Color>
            <Color x:Key="AccentMuted">#9B6C4D</Color>

            <!-- ── Surfaces ── -->
            <Color x:Key="Surface">#101C1B</Color>
            <Color x:Key="SurfacePanel">#1A2B29</Color>
            <Color x:Key="SurfaceElevated">#29433F</Color>
            <Color x:Key="SurfaceHover">#355850</Color>

            <!-- ── Borders ── -->
            <Color x:Key="BorderSubtle">#52766D</Color>

            <!-- ── Text ── -->
            <Color x:Key="OnSurface">#F1F8F4</Color>
            <Color x:Key="TextSecondary">#BBD0C7</Color>
            <Color x:Key="TextTertiary">#91ADA2</Color>
            <Color x:Key="TextPlaceholder">#86A297</Color>
            <Color x:Key="TextOnPrimary">#06110E</Color>
            <Color x:Key="DisabledText">#6D8880</Color>

            <!-- ── State: Success ── -->
            <Color x:Key="Success">#4CAF50</Color>
            <Color x:Key="SuccessLight">#5DCF64</Color>
            <Color x:Key="SuccessBg">#1E3A26</Color>
            <Color x:Key="SuccessBorder">#2E6B47</Color>
            <Color x:Key="SuccessText">#A3D4B3</Color>

            <!-- ── State: Error ── -->
            <Color x:Key="Error">#E57373</Color>
            <Color x:Key="ErrorLight">#FF8A8A</Color>
            <Color x:Key="ErrorBg">#3A1717</Color>
            <Color x:Key="SurfaceErrorBg">#3A1717</Color>
            <Color x:Key="ErrorBorder">#6B2C2C</Color>
            <Color x:Key="ErrorText">#FFB3B3</Color>

            <!-- ── State: Warning ── -->
            <Color x:Key="Warning">#FFD166</Color>
            <Color x:Key="WarningLight">#FFE59e</Color>
            <Color x:Key="WarningBg">#33240B</Color>
            <Color x:Key="SurfaceWarningBg">#33240B</Color>
            <Color x:Key="WarningBorder">#7A4F00</Color>
            <Color x:Key="WarningText">#F0C14B</Color>
            <Color x:Key="WarningTextSecondary">#C49300</Color>

            <!-- ── State: Info (distinct from Success) ── -->
            <Color x:Key="Info">#60A5FA</Color>
            <Color x:Key="InfoLight">#93C5FD</Color>
            <Color x:Key="InfoBg">#1E3A8A</Color>
            <Color x:Key="SurfaceInfoBg">#1E3A8A</Color>
            <Color x:Key="InfoBorder">#60A5FA</Color>
            <Color x:Key="InfoText">#93C5FD</Color>

            <!-- ── Focus ring ── -->
            <Color x:Key="FocusRing">#E5BE72</Color>

            <!-- ── Debug panel ── -->
            <Color x:Key="DebugBg">#0B1112</Color>
            <Color x:Key="DebugText">#9FE0B4</Color>
            <Color x:Key="DebugBorder">#3A514D</Color>

            <!-- ── Confidence bar (colorblind-safe blue/red instead of green/red) ── -->
            <Color x:Key="ConfidenceMatched">#60A5FA</Color>
            <Color x:Key="ConfidenceError">#E57373</Color>
            <Color x:Key="ConfidenceMatchedBg">#1E3A8A</Color>
            <Color x:Key="ConfidenceErrorBg">#3A1717</Color>

            <!-- Global label style -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
                <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
            </Style>



            <!-- Global button style: full touch target (min 48dp) and states -->
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
                <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
                <Setter Property="BackgroundColor" Value="{StaticResource SurfacePanel}" />
                <Setter Property="BorderColor" Value="{StaticResource BorderSubtle}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="MinimumHeightRequest" Value="48" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHover}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHover}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Focused">
                                <VisualState.Setters>
                                    <Setter Property="BorderColor" Value="{StaticResource FocusRing}" />
                                    <Setter Property="BorderWidth" Value="2" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.4" />
                                    <Setter Property="IsEnabled" Value="False" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Title Label Style -->
            <Style x:Key="TitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
                <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
            </Style>

            <!-- Primary button style (green background, dark text, min 48dp) -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextOnPrimary}" />
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="MinimumHeightRequest" Value="48" />
                <Setter Property="Padding" Value="18,12" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource PrimaryHover}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource PrimaryPressed}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Focused">
                                <VisualState.Setters>
                                    <Setter Property="BorderColor" Value="{StaticResource FocusRing}" />
                                    <Setter Property="BorderWidth" Value="2" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.4" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Outlined secondary button style -->
            <Style x:Key="OutlineButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
                <Setter Property="TextColor" Value="{StaticResource Accent}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="BorderColor" Value="{StaticResource BorderSubtle}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="MinimumHeightRequest" Value="48" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceElevated}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHover}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.4" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Compact toolbar button style for icon/small action buttons (min 48dp touch target) -->
            <Style x:Key="CompactActionButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
                <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceElevated}" />
                <Setter Property="BorderColor" Value="{StaticResource BorderSubtle}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="MinimumHeightRequest" Value="48" />
                <Setter Property="MinimumWidthRequest" Value="48" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHover}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHover}" />
                                    <Setter Property="Scale" Value="0.96" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.4" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Global entry style: disabled dimming -->
            <Style TargetType="Entry">
                <Setter Property="PlaceholderColor" Value="{StaticResource TextPlaceholder}" />
                <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
                <Setter Property="BackgroundColor" Value="{StaticResource SurfacePanel}" />
                <Setter Property="MinimumHeightRequest" Value="48" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.4" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Global picker style: disabled dimming -->
            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
                <Setter Property="TitleColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="BackgroundColor" Value="{StaticResource SurfacePanel}" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
                <Setter Property="MinimumHeightRequest" Value="48" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.55" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
